# --- App ---
LOG_LEVEL=INFO

# --- LLM / STT Provider ---
# Recommended: Groq (OpenAI-compatible API)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional fallback: OpenAI key (used only if GROQ_API_KEY is not set)
OPENAI_API_KEY=

# Models (compatible with selected provider)
# Groq example transcription model: whisper-large-v3
# OpenAI example transcription model: whisper-1
TRANSCRIBE_MODEL=whisper-large-v3

# Groq example extraction model: llama-3.3-70b-versatile
# OpenAI example extraction model: gpt-4o-mini
EXTRACTION_MODEL=llama-3.3-70b-versatile

# --- Twilio (required for media download) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# --- Google Sheets ---
# Option A: local service account JSON file path
GOOGLE_SHEETS_CREDENTIALS_FILE=./google-service-account.json
# Option B: JSON string (single-line) for cloud deployments
GOOGLE_SHEETS_CREDENTIALS_JSON=

GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_WORKSHEET=Sheet1
